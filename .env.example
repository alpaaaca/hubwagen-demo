# Copy to .env and fill in. ./demo reads it; .env is not committed.

# A checkout of https://github.com/alpaaaca/hubwagen: ./demo build builds the
# binary from it, and the workers use its Python SDK (HUBWAGEN_SDK, set by
# ./demo from this). Relative to this folder.
HUBWAGEN_SRC=../hubwagen

# Where the server listens; the workers and the CLI connect there.
HUBWAGEN_LISTEN=127.0.0.1:7171

# How many worker processes ./demo workers starts.
HUBWAGEN_WORKERS=3

# Optional: an S3 bucket (or S3-compatible store) for the data versions,
# as s3://bucket[/prefix]. Empty: a directory under server/.hubwagen.
HUBWAGEN_BUCKET=
HUBWAGEN_S3_ENDPOINT=     # MinIO, R2, ...: https://host[:port]; empty for AWS
HUBWAGEN_S3_REGION=       # empty: asked of the store

# Credentials for the bucket, given to the server only. Values, or read
# from files so the secrets stay where they are:
#   AWS_ACCESS_KEY_ID="$(cat ~/.config/hubwagen/s3_access_key_id)"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
