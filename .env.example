# Copy to .env and fill in. ./moksha.sh reads it; .env is not committed.

# A checkout of https://github.com/alpaaaca/moksha: ./moksha.sh build builds the
# binary from it, and the workers use its Python SDK (MOKSHA_SDK, set by
# ./moksha.sh from this). Relative to this folder.
MOKSHA_SRC=../moksha

# Where the server listens; the workers and the CLI connect there.
MOKSHA_LISTEN=127.0.0.1:7171

# How many worker processes ./moksha.sh workers starts.
MOKSHA_WORKERS=3

# Optional: an S3 bucket (or S3-compatible store) for the data versions,
# as s3://bucket[/prefix]. Empty: a directory under server/.moksha.
MOKSHA_BUCKET=
MOKSHA_S3_ENDPOINT=     # MinIO, R2, ...: https://host[:port]; empty for AWS
MOKSHA_S3_REGION=       # empty: asked of the store

# Credentials for the bucket, given to the server only. Values, or read
# from files so the secrets stay where they are:
#   AWS_ACCESS_KEY_ID="$(cat ~/.config/moksha/s3_access_key_id)"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
